# Development-only Compose defaults. Do not use these values for production.
POSTGRES_USER=quotepilot
POSTGRES_PASSWORD=quotepilot_dev
POSTGRES_DB=quotepilot_dev
POSTGRES_PORT=5432

# Root native commands use these same values via Docker Compose configuration.
# Deployment override: export DATABASE_URL with URL-encoded credentials and TLS options.
# Never commit a real DATABASE_URL or use the development defaults in production.

# Development-only browser origin. Production requires HTTPS and no local HTTP flag.
AUTH_ORIGIN=http://localhost:5173
AUTH_LOCAL_HTTP=1
